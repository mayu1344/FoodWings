# Copy to .env and change the secrets. Never commit .env to git.
DATABASE_URL=postgresql://app_user:change_me_in_env@localhost:5432/swiggy_db
TOKEN_SECRET=replace-with-a-long-random-string
OTP_DEV_MODE=true                 # true = OTP is returned in the API response (local testing only)
ENABLE_MOCK_GATEWAY=true          # local fake gateway; in production use Razorpay/Stripe SDK
MOCKPAY_WEBHOOK_SECRET=replace-with-webhook-secret
LOG_FILE=logs/app.log
